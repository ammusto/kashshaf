# Virtual Environment
venv/

# Dependencies
node_modules/
target/
# `cargo test --workspace` writes here, so a running debug build is not
# relinked out from under the user. Keep it: it is a warm build cache, and
# rebuilding it from cold costs 15-25 minutes before a test runs. See
# CLAUDE.md, "Testing".
target-test/

# Build outputs
dist/
src-tauri/target/
lab/dist/
lab/src-tauri/target/

# Local data (users download separately)
src-tauri/data/
data/

# Environment
.env
.env.local

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Rust
**/*.rs.bk

# TypeScript
*.tsbuildinfo

# Internal Documents (tracked exceptions: the release tooling and the announcements source)
releases/
scripts/*
!scripts/release.py
!scripts/check_release.py
!scripts/build_app_manifest.py
!scripts/generate_announcement.py
!scripts/announcements/
dev-docs/
# .release/min_supported_version is written by scripts/release.py and TRACKED:
# the workflow's manifest job reads it from the tagged commit.

CLAUDE.md
